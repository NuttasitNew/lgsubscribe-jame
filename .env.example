NEXT_PUBLIC_SITE_URL=https://www.lgthailand-subscribe.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Provision these from the Vercel Marketplace Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_PRISMA_URL=

# LINE credentials are entered in /backoffice/line/settings/ and stored encrypted in the
# database. These variables remain only as a fallback while nothing is saved there.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# AES-256-GCM key for secrets saved from the backoffice: `openssl rand -base64 32`.
# Keep it outside the database and never change it without re-entering the saved secrets.
SETTINGS_ENCRYPTION_KEY=

# Legacy LINE dashboard remains available only in local development.
BACKOFFICE_DESIGN_PREVIEW=false

# Username defaults to admin. Hash format: scrypt:<32 hex salt>:<128 hex hash>.
BACKOFFICE_USERNAME=admin
BACKOFFICE_PASSWORD_HASH=
BACKOFFICE_SESSION_SECRET=

# Opt in only for deployments whose traffic should be stored. Use a separate
# random secret (32+ characters); preserve it so historical visitors stay stable.
WEB_ANALYTICS_ENABLED=false
WEB_ANALYTICS_SECRET=

# Google Ads Script -> signed daily snapshots (a dedicated 32+ character secret).
GOOGLE_REPORT_SYNC_SECRET=
GOOGLE_ADS_CUSTOMER_ID=7588597274
GA4_PROPERTY_ID=553934775

# Server-side daily pull (Vercel Cron 03:00 Asia/Bangkok -> /api/cron/google-sync).
# CRON_SECRET: Vercel sends it as a Bearer token to cron paths (16+ random chars).
CRON_SECRET=
# One OAuth refresh token (scopes: adwords + analytics.readonly) from an account that can read both.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only when the Ads account is accessed through a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional override of the Google Ads REST version (default v23).
GOOGLE_ADS_API_VERSION=

# Daily Vercel Web Analytics pull (Vercel Cron 07:30 Asia/Bangkok -> /api/cron/vercel-traffic, same CRON_SECRET).
# Vercel access token with read access to the lgsubscribe-jame team project.
VERCEL_ANALYTICS_TOKEN=

# SEO articles (/backoffice/seo/ → /blog/<slug>/).
# Text (keyword research, SERP analysis, compare tables, writing) uses Claude by default:
# Sonnet 5.5 for research/writing, Haiku 5.5 for pipeline tasks. Research uses Claude web search/fetch.
ANTHROPIC_API_KEY=
# Images (gpt-image-2.5-sunburst, with real product photos as reference) need an OpenAI key.
CHATGPT_API_KEY=
# Optional: SEO_AI_PROVIDER=openai switches text back to OpenAI; SEO_AI_MODEL overrides the model.
SEO_AI_PROVIDER=
SEO_AI_MODEL=
# Google Search Console (daily /api/cron/seo-gsc-sync/, same CRON_SECRET). Service account added as a user on the property.
GSC_CLIENT_EMAIL=
# PKCS8 private key with \n escaped.
GSC_PRIVATE_KEY=
# e.g. sc-domain:lgthailand-subscribe.com or https://www.lgthailand-subscribe.com/
GSC_SITE_URL=
# Keyword Planner (monthly /api/cron/seo-keyword-ideas/) reuses GOOGLE_OAUTH_* + GOOGLE_ADS_DEVELOPER_TOKEN/CUSTOMER_ID
# above; the developer token needs Basic or Standard access.
# Cloudflare R2 bucket lg-jame-media for article images (S3 API token with Object Read & Write on that bucket).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lg-jame-media
R2_PUBLIC_URL=https://pub-cae070486a8a4b428b7435de2511207f.r2.dev
