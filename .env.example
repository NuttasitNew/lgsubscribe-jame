NEXT_PUBLIC_SITE_URL=https://www.lgthailand-subscribe.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Use .env.development.local locally and .env.production.local for explicit
# APP_ENV=production Prisma commands. Never point development at production.
APP_ENV=development
DATABASE_ENV=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_PRISMA_URL=

# Create these in LINE Developers > Messaging API.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Local development only; ignored on Vercel and production builds.
BACKOFFICE_DESIGN_PREVIEW=false
# Generate a scrypt hash with npm run backoffice:credentials (never a public env).
BACKOFFICE_PASSWORD_HASH=
BACKOFFICE_SESSION_SECRET=

# Search Console property: sc-domain:lgthailand-subscribe.com or exact URL prefix.
GSC_SITE_URL=
# Entire service-account JSON as a single env value. Read-only Search Console access.
GSC_SERVICE_ACCOUNT_JSON=
# Only needed when using Google's HTML-tag ownership verification method.
GOOGLE_SITE_VERIFICATION=
# Random secret of at least 32 characters; required for the scheduled sync route.
CRON_SECRET=
