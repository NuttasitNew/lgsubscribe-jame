generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Anonymous first-party traffic. Never store IPs, query strings or full referrers.
model WebPageView {
  eventId           String   @id @db.Uuid
  visitorHash       String   @db.VarChar(64)
  path              String   @db.VarChar(500)
  occurredAt        DateTime @default(now())
  eventType         String   @default("page_view") @db.VarChar(20)
  contactMethod     String?  @db.VarChar(10)
  sessionHash       String?  @db.VarChar(64)
  source            String   @default("unknown") @db.VarChar(150)
  medium            String   @default("unknown") @db.VarChar(50)
  channel           String   @default("unknown") @db.VarChar(30)
  campaign          String?  @db.VarChar(150)
  attributionMethod String   @default("unknown") @db.VarChar(20)
  referrerHost      String?  @db.VarChar(253)
  clickIdHash       String?  @db.VarChar(64)
  device            String   @default("unknown") @db.VarChar(10)
  country           String?  @db.VarChar(2)

  @@index([occurredAt, visitorHash])
}

// Complete replaceable daily snapshots; sources stay separate from site events.
model GoogleDailySnapshot {
  id         String   @id @default(uuid())
  provider   String   @db.VarChar(20)
  externalId String   @db.VarChar(20)
  day        DateTime @db.Date
  currency   String   @db.VarChar(3)
  timeZone   String   @db.VarChar(50)
  quality    String   @default("reported") @db.VarChar(20)
  asOf       DateTime
  syncedAt   DateTime @default(now())
  rows       Json

  @@unique([provider, externalId, day])
  @@index([provider, day])
}

model BackofficeUser {
  id             String   @id @default(uuid()) @db.Uuid
  username       String   @unique @db.VarChar(80)
  displayName    String   @db.VarChar(150)
  passwordHash   String   @db.VarChar(200)
  permissions    String[] @default([])
  isActive       Boolean  @default(true)
  isOwner        Boolean  @default(false)
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BackofficeUserAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  targetId  String   @db.Uuid
  action    String   @db.VarChar(30)
  changes   Json
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

// Aggregated Vercel reports retain Vercel's UTC day boundaries and never mix
// with consent-gated first-party visitor identities or Google snapshots.
model VercelTrafficDay {
  projectId String   @db.VarChar(100)
  day       DateTime @db.Date
  visitors  Int
  pageviews Int
  asOf      DateTime
  updatedAt DateTime @updatedAt

  @@id([projectId, day])
}

model VercelTrafficPeriod {
  projectId String   @db.VarChar(100)
  start     DateTime @db.Date
  end       DateTime @db.Date
  visitors  Int
  pageviews Int
  asOf      DateTime
  updatedAt DateTime @updatedAt

  @@id([projectId, start, end])
}

// Shared across serverless instances; hashes replace raw client addresses.
model BackofficeLoginAttempt {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum LineWebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

// LINE identity is deliberately separate from future customer/application
// records. A person can follow or message the OA before sharing business data.
model LineUser {
  userLineId           String    @id
  displayName          String
  pictureUrl           String?
  statusMessage        String?
  language             String?
  isFollowing          Boolean   @default(false)
  followStateChangedAt DateTime?
  followedAt           DateTime?
  unfollowedAt         DateTime?
  profileSyncedAt      DateTime?
  lastSeenAt           DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  messages      LineMessage[]
  threads       LineChatThread[]
  dailyActivity LineDailyActivity[]

  @@index([isFollowing])
  @@index([lastSeenAt(sort: Desc)])
}

// Durable idempotency and audit record for every event accepted from LINE.
model LineWebhookEvent {
  id             String            @id @default(uuid())
  webhookEventId String            @unique
  destination    String
  eventType      String
  eventData      Json
  timestamp      BigInt
  status         LineWebhookStatus @default(PENDING)
  attemptCount   Int               @default(1)
  processedAt    DateTime?
  errorMessage   String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  message LineMessage?

  @@index([status, updatedAt])
  @@index([eventType, timestamp(sort: Desc)])
}

// Normalized/searchable message plus the complete LINE message object.
model LineMessage {
  lineMessageId    String   @id
  webhookEventId   String   @unique
  messageType      String
  sourceType       String
  sourceUserId     String?
  sourceGroupId    String?
  sourceRoomId     String?
  replyToken       String?
  text             String?  @db.Text
  messageData      Json
  timestamp        BigInt
  contentUpdatedAt BigInt?
  isRedelivery     Boolean  @default(false)
  createdAt        DateTime @default(now())

  webhookEvent LineWebhookEvent @relation(fields: [webhookEventId], references: [webhookEventId], onDelete: Cascade)
  user         LineUser?        @relation(fields: [sourceUserId], references: [userLineId], onDelete: SetNull)

  @@index([sourceUserId, timestamp(sort: Desc)])
  @@index([sourceGroupId, timestamp(sort: Desc)])
  @@index([messageType, timestamp(sort: Desc)])
}

// Durable privacy tombstone so an unsend that arrives before a redelivered
// message still prevents that message body from being stored later.
model LineUnsentMessage {
  lineMessageId        String   @id
  unsendWebhookEventId String   @unique
  unsentAt             DateTime
  createdAt            DateTime @default(now())
}

// Latest edit received before its original message. LINE may deliver edit
// webhooks out of order, so this is applied when the original arrives later.
model LinePendingMessageEdit {
  lineMessageId  String   @id
  webhookEventId String   @unique
  text           String?  @db.Text
  messageData    Json
  editedAt       BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Fast chat-list projection. Messages and raw events remain the source of truth.
model LineChatThread {
  threadKey       String    @id
  sourceType      String
  lineUserId      String?
  groupId         String?
  roomId          String?
  lastMessageId   String?
  lastMessageText String?   @db.Text
  lastMessageAt   DateTime?
  unreadCount     Int       @default(0)
  totalMessages   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user LineUser? @relation(fields: [lineUserId], references: [userLineId], onDelete: SetNull)

  @@index([lastMessageAt(sort: Desc)])
  @@index([lineUserId])
}

// One row per LINE user per UTC day for inexpensive operational reporting.
model LineDailyActivity {
  id             String   @id @default(uuid())
  activityDate   DateTime @db.Date
  userLineId     String
  firstEventType String
  lastEventType  String
  firstEventAt   DateTime
  lastEventAt    DateTime
  messageCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user LineUser @relation(fields: [userLineId], references: [userLineId], onDelete: Cascade)

  @@unique([activityDate, userLineId])
  @@index([activityDate(sort: Desc)])
}

// Integration credentials entered in the backoffice. Values are AES-256-GCM
// ciphertext (lib/settings/secret-crypto.ts); the key never lives in the database.
model IntegrationSecret {
  key           String   @id @db.VarChar(80)
  ciphertext    String
  last4         String   @db.VarChar(4)
  updatedById   String?  @db.Uuid
  updatedByName String?  @db.VarChar(150)
  updatedAt     DateTime @updatedAt
}

model IntegrationSecretAudit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(80)
  action    String   @db.VarChar(20)
  actorId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ============================================================================
// SEO article system (ported from hmp-frontend). AI drafts articles, a
// backoffice user reviews/edits/publishes them to /blog/<slug>, and Google
// Search Console metrics (SeoSearchQueryDaily) show how each article performs.
// Code: feature/backoffice/seo/, lib/gsc/, lib/google-ads/, lib/ai/
// ============================================================================
model SeoArticle {
  seoArticleId        Int              @id @default(autoincrement())
  status              SeoArticleStatus @default(DRAFT)
  slug                String           @unique // path /blog/<slug>
  title               String
  metaDescription     String
  keywords            String[]
  targetKeyword       String? // primary keyword compared against SeoSearchQueryDaily
  titleEn             String?
  metaDescriptionEn   String?
  keywordsEn          String[]         @default([])
  contentEnSourceHash String?
  contentJsonEn       Json?
  contentJson         Json // block v2 { version: 2, coverImage?, category, blocks, faq }
  contentUpdatedAt    DateTime         @default(now())
  draftJson           Json? // in-progress edit snapshot (autosave)
  draftSavedAt        DateTime?
  draftSavedBy        String?
  origin              SeoArticleOrigin @default(MANUAL)
  promptBrief         String?
  sourceDate          String // yyyy-MM-dd (Bangkok)
  sourceTopics        Json
  aiModel             String
  approvedBy          String?
  publishedAt         DateTime?
  publishedCommitSha  String? // unused in lg-jame (articles are served from the database)
  rejectedReason      String?
  deletedAt           DateTime? // soft delete only: the slug stays reserved
  deletedBy           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  images SeoArticleImage[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([sourceDate, origin])
}

enum SeoArticleStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}

enum SeoArticleOrigin {
  CHAT
  MANUAL
  CATEGORY // written from a catalog product category
  LEGACY
}

model SeoArticleJob {
  seoArticleJobId Int                 @id @default(autoincrement())
  jobType         SeoArticleJobType   @default(WRITE_CATEGORY)
  status          SeoArticleJobStatus @default(QUEUED)
  categoryCode    String?
  categoryName    String?
  topic           String
  targetKeyword   String?
  tone            String?
  generateImages  Boolean             @default(false)
  payload         Json?
  resultJson      Json?
  requestedBy     String
  seoArticleId    Int?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([seoArticleId, status])
  @@index([createdAt])
}

enum SeoArticleJobType {
  WRITE_CATEGORY
  WRITE_NOW
  GENERATE_IMAGES
  TRANSLATE_EN
  SINGLE_IMAGE
  WRITE_FAQ
  TRANSLATE_FAQ_EN
}

enum SeoArticleJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Google Search Console rows for /blog/ pages: one query per page per day.
model SeoSearchQueryDaily {
  id          BigInt   @id @default(autoincrement())
  date        DateTime @db.Date
  page        String
  query       String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  position    Float
  syncedAt    DateTime

  @@unique([date, page, query])
  @@index([page, date])
  @@index([query, date])
}

model SeoArticleImage {
  seoArticleImageId Int                      @id @default(autoincrement())
  seoArticleId      Int
  url               String
  alt               String
  prompt            String
  placement         SeoArticleImagePlacement
  style             SeoArticleImageStyle
  createdBy         String
  lastUsedAt        DateTime?
  createdAt         DateTime                 @default(now())

  seoArticle SeoArticle @relation(fields: [seoArticleId], references: [seoArticleId], onDelete: Cascade)

  @@index([seoArticleId, createdAt])
  @@index([placement, createdAt])
}

enum SeoArticleImagePlacement {
  COVER
  INLINE
}

enum SeoArticleImageStyle {
  PHOTO
  INFOGRAPHIC
}

// Google Ads Keyword Planner volumes, seeded per catalog category.
model SeoKeywordIdea {
  seoKeywordIdeaId     Int      @id @default(autoincrement())
  keyword              String   @unique
  avgMonthlySearches   Int      @default(0)
  competition          String   @default("UNSPECIFIED")
  competitionIndex     Int?
  lowTopOfPageBidBaht  Float?
  highTopOfPageBidBaht Float?
  monthlyVolumes       Json?
  categoryCodes        String[]
  syncedAt             DateTime
  createdAt            DateTime @default(now())

  @@index([avgMonthlySearches(sort: Desc)])
  @@index([syncedAt])
  @@index([categoryCodes], type: Gin)
}

// AI-proposed FAQ entries shown on /faq after a backoffice user publishes them.
model AskAnswerFaq {
  askAnswerFaqId     Int                @id @default(autoincrement())
  faqKey             String             @unique
  question           String
  answer             String
  questionEn         String?
  answerEn           String?
  status             AskAnswerFaqStatus @default(DRAFT)
  targetKeyword      String?
  reason             String?
  proofNote          String?
  relatedSlug        String?
  requestedBy        String
  seoArticleJobId    Int?
  publishedBy        String?
  publishedAt        DateTime?
  publishedCommitSha String?
  rejectedReason     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
}

enum AskAnswerFaqStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

// Singleton brand guidance + reference photos for AI article images.
model SeoBrandProfile {
  id           String   @id
  systemPrompt String
  references   Json
  revision     Int      @default(1)
  updatedBy    String
  updatedAt    DateTime @updatedAt
}

// One row per LLM call (tokens + estimated USD cost).
model AiUsageLog {
  id                Int             @id @default(autoincrement())
  createdAt         DateTime        @default(now())
  provider          AiUsageProvider
  model             String
  feature           AiUsageFeature
  operation         String?
  inputTokens       Int             @default(0)
  cachedInputTokens Int             @default(0)
  outputTokens      Int             @default(0)
  reasoningTokens   Int             @default(0)
  estimatedCostUsd  Float           @default(0)
  durationMs        Int?
  success           Boolean         @default(true)
  errorCode         String?
  refId             String?
  actorName         String?

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
}

enum AiUsageProvider {
  OPENAI
  ANTHROPIC
}

enum AiUsageFeature {
  SEO_ARTICLE_WRITE
  SEO_ARTICLE_TRANSLATE
  SEO_ARTICLE_IMAGE_BRIEF
  SEO_ARTICLE_TOPIC
  SEO_ARTICLE_NORMALIZE
  ASK_ANSWER_FAQ_WRITE
  ASK_ANSWER_FAQ_TRANSLATE
  OTHER
}
